{
  "openapi": "3.0.3",
  "info": {
    "title": "Happengo API (placeholder)",
    "version": "0.0.0-placeholder",
    "description": "PLACEHOLDER. Not the Happengo API contract. The backend owns the spec and commits it at api/openapi.json. pnpm api:generate uses that file when it exists, and this file only until then. This document describes GET /health and GET /v1/events?bbox=minLng,minLat,maxLng,maxLat (ADR 0006). Tag enums are omitted on purpose; they belong in the backend OpenAPI document."
  },
  "x-happengo-placeholder": true,
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "The process is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "listEventsByBbox",
        "summary": "Events inside a map viewport",
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "required": true,
            "description": "minLng,minLat,maxLng,maxLat in WGS84. The box includes its boundary. A viewport that crosses the antimeridian is outside the product.",
            "schema": {
              "type": "string",
              "example": "24.6,59.3,24.9,59.5"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Events the caller can see in the viewport. The list is capped at about 500; truncated is true when the cap dropped rows. Each event includes the point for a pin. Screens show address, not coordinates.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventList"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        }
      },
      "EventList": {
        "type": "object",
        "required": ["events", "truncated"],
        "properties": {
          "truncated": {
            "type": "boolean"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventSummary"
            }
          }
        }
      },
      "EventSummary": {
        "type": "object",
        "required": ["id", "title", "startAt", "endAt", "timeZoneId", "address", "location"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "timeZoneId": {
            "type": "string",
            "description": "IANA time zone the event was created in."
          },
          "address": {
            "type": "string",
            "description": "Human-readable address. Never a raw coordinate string."
          },
          "location": {
            "$ref": "#/components/schemas/GeoPoint"
          }
        }
      },
      "GeoPoint": {
        "type": "object",
        "required": ["longitude", "latitude"],
        "properties": {
          "longitude": {
            "type": "number"
          },
          "latitude": {
            "type": "number"
          }
        }
      }
    }
  }
}
