{
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownNetworks": [],
    "KnownProxies": []
  },
  "RateLimiting": {
    "Writes": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Uploads": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "MapReads": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "ShareReads": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
