# MapLibre style JSON. OpenFreeMap Positron needs no key.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Optional. Substituted only when the style URL contains {key}.
EXPO_PUBLIC_MAP_API_KEY=

# Local API from backend/src/Happengo.Api launchSettings.
EXPO_PUBLIC_API_URL=http://localhost:5080

# Development only. Production bundles do not start mocks.
# Set to false to call EXPO_PUBLIC_API_URL from a dev build.
EXPO_PUBLIC_API_MOCK=true

# OIDC configuration stays blank until Brenner picks Entra External ID or Auth0.
# The client uses authorization code + PKCE and never contains a client secret.
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=
# Optional separate OIDC client for the web build.
EXPO_PUBLIC_OIDC_CLIENT_ID_WEB=
# API audience the backend validates. Sent as the authorize "audience" parameter when set.
# Some providers need an API scope instead of, or in addition to, that parameter.
EXPO_PUBLIC_OIDC_API_SCOPE=
EXPO_PUBLIC_OIDC_API_AUDIENCE=
# Optional override. Defaults to the happengo://auth/callback native URI and
# the current web origin's /auth/callback path.
EXPO_PUBLIC_OIDC_REDIRECT_URI_NATIVE=
EXPO_PUBLIC_OIDC_REDIRECT_URI_WEB=
