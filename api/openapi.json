{
  "openapi": "3.1.1",
  "info": {
    "title": "Happengo API",
    "description": "Read API for map-first local events. ProblemDetails type values are stable codes. EventTag is the fixed tag vocabulary. Bearer tokens are validated against the configured OIDC authority.",
    "version": "v1"
  },
  "paths": {
    "/v1/events": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Events in the map viewport that have not ended.",
        "description": "bbox is minLng,minLat,maxLng,maxLat (SRID 4326). Uses location \u0026\u0026 ST_MakeEnvelope. Unlisted events are never returned. At most 500 events, happening-now first, then start time. truncated is true when more events matched. tags keeps events that have any of the named tags.",
        "operationId": "ListEventsInBounds",
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventMapResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Create an event and join as its owner.",
        "description": "Requires authentication. StartAt and EndAt are required; StartAt cannot be in the past, EndAt must be after StartAt and in the future, and the duration cannot exceed 7 days. The owner is created as attending. The server generates the event ID and share token.",
        "operationId": "CreateEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/mine": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "List events the caller owns or attends, including past events.",
        "description": "Requires authentication. Includes upcoming and past events created by the caller or events they are attending, plus active attendance requests.",
        "operationId": "GetMyEvents",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventMapResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/shared/{token}": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Read a live unlisted event by its share token.",
        "description": "The token does not reveal public or friends-only events, and it does not reveal an event that has ended.",
        "operationId": "GetSharedEvent",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{id}": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "One event the caller is allowed to read.",
        "description": "Hidden, unlisted (without being the owner), and ended events the caller did not attend return 404. The share token is not returned; only its hash is stored.",
        "operationId": "GetEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{eventId}/attendance": {
      "post": {
        "tags": [
          "Attendance"
        ],
        "summary": "Join an event or request to attend.",
        "operationId": "RequestEventAttendance",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{eventId}/attendance/requests": {
      "get": {
        "tags": [
          "Attendance"
        ],
        "summary": "List pending attendance request user IDs for an event owner.",
        "operationId": "GetEventAttendanceRequests",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingAttendanceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{eventId}/attendance/me": {
      "get": {
        "tags": [
          "Attendance"
        ],
        "summary": "Get the caller\u0027s attendance state for an event.",
        "operationId": "GetMyEventAttendance",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "shareToken",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyAttendanceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{eventId}/attendance/requests/{userId}/approve": {
      "post": {
        "tags": [
          "Attendance"
        ],
        "summary": "Approve a pending attendance request.",
        "operationId": "ApproveEventAttendance",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{eventId}/attendance/requests/{userId}/reject": {
      "post": {
        "tags": [
          "Attendance"
        ],
        "summary": "Reject a pending attendance request.",
        "operationId": "RejectEventAttendance",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{eventId}/attendance/cancel": {
      "post": {
        "tags": [
          "Attendance"
        ],
        "summary": "Cancel the caller\u0027s own attendance.",
        "operationId": "CancelEventAttendance",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprovalMode": {
        "enum": [
          "open",
          "approval"
        ],
        "type": "string"
      },
      "AttendanceResponse": {
        "required": [
          "eventId",
          "status",
          "attendingCount"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/AttendanceStatus"
          },
          "attendingCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AttendanceStatus": {
        "enum": [
          "attending",
          "requested",
          "rejected",
          "cancelled"
        ],
        "type": "string"
      },
      "CreateEventRequest": {
        "required": [
          "title",
          "startAt",
          "endAt",
          "timeZoneId",
          "address",
          "longitude",
          "latitude",
          "visibility",
          "approvalMode",
          "tags"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "timeZoneId": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "visibility": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/EventVisibility"
              }
            ]
          },
          "approvalMode": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ApprovalMode"
              }
            ]
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/EventTag"
            }
          }
        }
      },
      "EventMapResponse": {
        "required": [
          "items",
          "limit",
          "truncated"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventResponse"
            }
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "EventResponse": {
        "required": [
          "id",
          "title",
          "description",
          "startAt",
          "endAt",
          "timeZoneId",
          "address",
          "tags",
          "visibility",
          "approvalMode",
          "happeningNow",
          "isOwner",
          "attendingCount",
          "longitude",
          "latitude"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "timeZoneId": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventTag"
            }
          },
          "visibility": {
            "$ref": "#/components/schemas/EventVisibility"
          },
          "approvalMode": {
            "$ref": "#/components/schemas/ApprovalMode"
          },
          "happeningNow": {
            "type": "boolean"
          },
          "isOwner": {
            "type": "boolean"
          },
          "attendingCount": {
            "type": "integer",
            "format": "int32"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "shareToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EventTag": {
        "enum": [
          "Music",
          "Sports",
          "Food",
          "Art",
          "Family",
          "Tech",
          "Nightlife",
          "Outdoor",
          "Culture",
          "Education"
        ],
        "type": "string"
      },
      "EventVisibility": {
        "enum": [
          "public",
          "unlisted",
          "friends_only"
        ],
        "type": "string"
      },
      "JoinEventRequest": {
        "required": [
          "shareToken"
        ],
        "type": "object",
        "properties": {
          "shareToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MyAttendanceResponse": {
        "required": [
          "eventId",
          "status"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AttendanceStatus"
              }
            ]
          }
        }
      },
      "PendingAttendanceResponse": {
        "required": [
          "userIds"
        ],
        "type": "object",
        "properties": {
          "userIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Events"
    },
    {
      "name": "Attendance"
    }
  ]
}
