# Copy to terraform.tfvars (gitignored) only when Brenner has approved a real apply.
# ADR 0002: do not apply prod until the first deployed environment is in use.
# Purge protection below is true. After apply it cannot be turned off.
# Replace every placeholder. Do not put secret values in this file or in terraform.tfvars.
# CI does not read this file. terraform validate does not need it.

subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

# Four lowercase letters or digits. Use a different suffix from dev and staging.
uniqueness_suffix = "prd1"

location = "northeurope"

postgres_administrator_object_id      = "00000000-0000-0000-0000-000000000000"
postgres_administrator_principal_name = "happengo-admins"
postgres_administrator_principal_type = "Group"

oidc_authority = "https://example.ciamlogin.com/00000000-0000-0000-0000-000000000000/v2.0"
oidc_audience  = "api://happengo"

# Same Burstable SKU as dev. Durability changes are backup days and Key Vault retention, not a larger server.
# Zone redundancy, geo-redundant backup, and General Purpose are not in this layout.
postgres_sku_name                    = "B_Standard_B1ms"
postgres_backup_retention_days       = 14
postgres_allow_azure_services        = true
postgres_firewall_rules              = []
log_daily_quota_gb                   = 1
container_cpu                        = 0.5
container_memory                     = "1Gi"
container_min_replicas               = 0
container_max_replicas               = 3
key_vault_purge_protection_enabled   = true
key_vault_soft_delete_retention_days = 90

container_image  = "mcr.microsoft.com/k8se/quickstart:latest"
container_port   = 8080
acr_login_server = null

key_vault_secret_environment_variables = {}
