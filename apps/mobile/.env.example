# MapLibre style JSON. OpenFreeMap Positron needs no key.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Optional. Substituted only when the style URL contains {key}.
EXPO_PUBLIC_MAP_API_KEY=

# Provisional until the backend PR documents its port.
EXPO_PUBLIC_API_URL=http://localhost:5080

# MSW (web) and the native fetch patch stay on until the API routes exist.
# Set to false to call EXPO_PUBLIC_API_URL directly.
EXPO_PUBLIC_API_MOCK=true
